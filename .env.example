# =============================================================================
# Digital Wallet Ledger Engine — Environment Variables
# =============================================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# NEVER commit .env to git. It contains secrets.
# .env.example is committed — it documents what vars are needed.
# =============================================================================

# -------------------------------------------------------------------------
# Application
# -------------------------------------------------------------------------
APP_NAME=digital-wallet-ledger-engine
APP_ENV=development
# Options: development, staging, production
# Controls: log format (pretty vs JSON), debug mode, CORS origins.

APP_DEBUG=true
# true = detailed error responses, auto-reload.
# MUST be false in production — exposes stack traces.

APP_VERSION=0.1.0

# -------------------------------------------------------------------------
# Server
# -------------------------------------------------------------------------
APP_HOST=0.0.0.0
APP_PORT=8000
# 0.0.0.0 = listen on all interfaces (required for Docker).
# 127.0.0.1 = localhost only (use for local dev without Docker).

# -------------------------------------------------------------------------
# Database (PostgreSQL)
# -------------------------------------------------------------------------
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/wallet_db
# Format: postgresql+asyncpg://<user>:<password>@<host>:<port>/<database>
#
# postgresql+asyncpg:// = tells SQLAlchemy to use the asyncpg driver.
# For Neon (production): use the pooled connection string from Neon dashboard.
# Example: postgresql+asyncpg://user:pass@ep-xyz.us-east-2.aws.neon.tech/wallet_db?sslmode=require

DB_POOL_SIZE=5
# Number of persistent connections in the pool.
# For Neon free tier: keep this LOW (3-5). Neon limits connections.
# For local PostgreSQL: can be higher (10-20).

DB_MAX_OVERFLOW=10
# Extra connections allowed beyond pool_size during traffic spikes.
# Total max connections = DB_POOL_SIZE + DB_MAX_OVERFLOW.

DB_POOL_TIMEOUT=30
# Seconds to wait for a connection from the pool before raising an error.

DB_ECHO=false
# true = log all SQL queries (useful for debugging, noisy in production).

# -------------------------------------------------------------------------
# Authentication (JWT)
# -------------------------------------------------------------------------
JWT_SECRET_KEY=change-me-to-a-random-64-char-string-in-production
# Used to sign JWT tokens. MUST be a long, random string in production.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
#
# If this leaks, attackers can forge valid tokens for any user.

JWT_ALGORITHM=HS256
# HS256 = HMAC-SHA256 (symmetric key). Simple, fast.
# RS256 = RSA-SHA256 (asymmetric key pair). Better for microservices
# where multiple services verify tokens but only one signs them.
# We use HS256 because this is a monolith.

ACCESS_TOKEN_EXPIRE_MINUTES=15
# Short-lived access tokens. If stolen, they expire quickly.
# Trade-off: shorter = more secure but more frequent refresh calls.
# Industry standard: 5-30 minutes.

REFRESH_TOKEN_EXPIRE_DAYS=7
# Long-lived refresh tokens. Stored as hashed values in the DB.
# When used, the old token is revoked and a new one is issued (rotation).

# -------------------------------------------------------------------------
# Redis
# -------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379/0
# Format: redis://<host>:<port>/<db_number>
#
# For Upstash (production): use the REST URL + token instead.
# UPSTASH_REDIS_REST_URL=https://xyz.upstash.io
# UPSTASH_REDIS_REST_TOKEN=your-token-here

REDIS_POOL_SIZE=5
# Connection pool size for Redis.

# -------------------------------------------------------------------------
# Rate Limiting
# -------------------------------------------------------------------------
RATE_LIMIT_PER_MINUTE=60
# Max requests per user per minute on general endpoints.

RATE_LIMIT_AUTH_PER_MINUTE=10
# Stricter limit on auth endpoints (login, register).
# Prevents brute-force attacks.

# -------------------------------------------------------------------------
# Idempotency
# -------------------------------------------------------------------------
IDEMPOTENCY_KEY_TTL_HOURS=24
# How long idempotency keys are valid. After TTL, the key can be reused.
# 24 hours is standard (Stripe uses 24h).

# -------------------------------------------------------------------------
# CORS (Cross-Origin Resource Sharing)
# -------------------------------------------------------------------------
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
# Comma-separated list of allowed frontend origins.
# In production: set to your actual frontend domain(s).

# -------------------------------------------------------------------------
# Logging
# -------------------------------------------------------------------------
LOG_LEVEL=INFO
# Options: DEBUG, INFO, WARNING, ERROR, CRITICAL
# DEBUG in development, INFO or WARNING in production.

LOG_FORMAT=console
# Options: console (pretty, colorful), json (structured, for log aggregators)
# Use "json" in production for Grafana/ELK/Datadog parsing.
